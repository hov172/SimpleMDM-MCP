{
  "mcpServers": {
    "simplemdm": {
      "command": "node",
      "args": ["/absolute/path/to/SimpleMDM-MCP/dist/index.js"],
      "env": {
        "SIMPLEMDM_API_KEY": "your-api-key-here",
        "SIMPLEMDM_ALLOW_WRITES": "true",
        "SIMPLEMDM_CONFIRM_MODE": "on",
        "SIMPLEMDM_CONFIRM_TTL_SECONDS": "120",
        "MCP_WRITE_AUDIT_DIR": "audit_log"
      }
    }
  }
}
